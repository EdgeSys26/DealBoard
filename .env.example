# Deal Board — independent product. Do not reuse Frontburner or Edge.Sys secrets.
# Production uses persistent Postgres (Supabase). Local can use the same DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
AUTH_SECRET="replace-with-a-long-random-string"

# Optional live AVM. If unset, Noblesville fixtures use a clearly labeled mock AVM.
RENTCAST_API_KEY=""
REAPI_API_KEY=""
