# Deal Board — independent product. Do not reuse Frontburner or Edge.Sys secrets.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"

# On Vercel, SQLite is copied to /tmp/dealboard.db on boot (read-only deploys).
# DEALBOARD_TMP_DB=1

# Optional live AVM. If unset, Noblesville fixtures use a clearly labeled mock AVM.
RENTCAST_API_KEY=""
REAPI_API_KEY=""
